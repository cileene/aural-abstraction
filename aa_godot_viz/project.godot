; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://fmod/"
General/should_load_by_name=true

[application]

config/name="aa_godot_viz"
run/main_scene="uid://f3cedgdj3cjk"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

FmodManager="*uid://cds10pm7hwn3p"

[dotnet]

project/assembly_name="aa_godot_viz"

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg", "res://addons/rider-plugin/plugin.cfg")

[file_customization]

folder_colors={
"res://materials/": "yellow",
"res://prefabs/": "teal",
"res://scenes/": "red",
"res://scripts/": "purple"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
